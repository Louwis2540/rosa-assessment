# ===== ROSA Assessment - Environment Variables =====
# Copy this file to .env and fill in your values

# Path to Google Service Account JSON key file
GOOGLE_CREDENTIALS_JSON=credentials.json

# Google Sheet ID (from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Drive Folder ID (from the URL: drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Dashboard password (change this!)
ADMIN_PASSWORD=admin1234

# App settings
APP_TITLE=ระบบประเมินความเสี่ยง ROSA
